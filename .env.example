# Server Configuration
PORT=3000

# Google Gemini API Key for Malayalam Understanding & Response Generation
GEMINI_API_KEY=

# Google Cloud Text-to-Speech Configuration (optional - works out of the box with cloud fallback)
GOOGLE_TTS_API_KEY=

# Malayalam Voice Configuration Defaults
GOOGLE_TTS_VOICE_NAME=ml-IN-Wavenet-A
GOOGLE_TTS_LANGUAGE_CODE=ml-IN
GOOGLE_TTS_GENDER=FEMALE
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0
